# ---------------------------------------------------------------
# Schutz sensibler Dateien im Web-Root
# ---------------------------------------------------------------

# Versteckte Dateien (.git, .gitignore, …) nie ausliefern
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Zugangsdaten, DB-Verbindung und Doku nicht direkt abrufbar
<FilesMatch "^(config\.php|config\.example\.php|db\.php|README\.md)$">
    Require all denied
</FilesMatch>

# Versteckte Ordner (.git, .idea), falls versehentlich hochgeladen
RedirectMatch 404 /\.(git|idea|vscode)(/|$)

# HTML, JavaScript und CSS bei jedem Aufruf auf Aktualität prüfen lassen.
# Ohne diese Regel behalten manche Browser (v.a. Safari) alte Versionen im Cache.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
